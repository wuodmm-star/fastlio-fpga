+// voxmap.hpp - FPGA-friendly replacement for the ikd-tree map (added 2026-11-10, phase 0 of the FPGA NN-search work)
+//
+// The map is a hash of 0.5 m voxels; each voxel holds at most CAP points (fixed-size bucket = one SDRAM burst later).
+// Insertion copies FAST-LIO's rules:
+//   add(p, downsample=true)  : the voxel keeps only the single point closest to the voxel centre (ikd-tree downsample)
+//   add(p, downsample=false) : append if there is room, otherwise replace the stored point farthest from the centre
+// Search: look at all voxels within R voxels of the query voxel ((2R+1)^3 voxels) and return the K nearest points.
+// Enabled with FPGA_NN_MODE=voxel, FPGA_NN_R=1|2 (default 1). Nothing changes when FPGA_NN_MODE is not set.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <omp.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace voxmap {
+
+const int CAP = 4;
+
+struct Bucket { int n = 0; float p[CAP][3]; };
+
+struct Map {
+    float vox = 0.5f;
+    int R = 1;
+    std::unordered_map<uint64_t, Bucket> m;
+    long n_points = 0;
+
+    static uint64_t key(int x, int y, int z) {
+        return ((uint64_t)(uint32_t)(x & 0x1FFFFF) << 42) | ((uint64_t)(uint32_t)(y & 0x1FFFFF) << 21) | (uint64_t)(uint32_t)(z & 0x1FFFFF);
+    }
+    void vidx(const float *p, int &x, int &y, int &z) const {
+        x = (int)std::floor(p[0] / vox); y = (int)std::floor(p[1] / vox); z = (int)std::floor(p[2] / vox);
+    }
+    float dc2(const float *p, int x, int y, int z) const {      // squared distance to the voxel centre
+        float cx = (x + 0.5f) * vox - p[0], cy = (y + 0.5f) * vox - p[1], cz = (z + 0.5f) * vox - p[2];
+        return cx * cx + cy * cy + cz * cz;
+    }
+    void add(const float *p, bool downsample) {
+        int x, y, z; vidx(p, x, y, z);
+        Bucket &b = m[key(x, y, z)];
+        if (downsample) {
+            float best = dc2(p, x, y, z); const float *bp = p;
+            for (int i = 0; i < b.n; i++) { float d = dc2(b.p[i], x, y, z); if (d < best) { best = d; bp = b.p[i]; } }
+            float keep[3] = {bp[0], bp[1], bp[2]};
+            n_points -= b.n - 1;
+            b.n = 1; std::memcpy(b.p[0], keep, sizeof(keep));
+        } else if (b.n < CAP) {
+            std::memcpy(b.p[b.n++], p, 3 * sizeof(float)); n_points++;
+        } else {
+            int far = 0; float fd = -1;
+            for (int i = 0; i < CAP; i++) { float d = dc2(b.p[i], x, y, z); if (d > fd) { fd = d; far = i; } }
+            std::memcpy(b.p[far], p, 3 * sizeof(float));
+        }
+    }
+    // K nearest within the (2R+1)^3 neighbourhood; out sorted by distance; returns count found
+    int search(const float *q, int K, float (*out)[3], float *d2) const {
+        int x, y, z; vidx(q, x, y, z);
+        int found = 0;
+        for (int dx = -R; dx <= R; dx++) for (int dy = -R; dy <= R; dy++) for (int dz = -R; dz <= R; dz++) {
+            auto it = m.find(key(x + dx, y + dy, z + dz));
+            if (it == m.end()) continue;
+            const Bucket &b = it->second;
+            for (int i = 0; i < b.n; i++) {
+                float ex = b.p[i][0] - q[0], ey = b.p[i][1] - q[1], ez = b.p[i][2] - q[2];
+                float d = ex * ex + ey * ey + ez * ez;
+                // insertion into the sorted K-list
+                int j = found < K ? found++ : K;
+                if (j == K) { if (d >= d2[K - 1]) continue; j = K - 1; }
+                while (j > 0 && d2[j - 1] > d) { d2[j] = d2[j - 1]; std::memcpy(out[j], out[j - 1], 3 * sizeof(float)); j--; }
+                d2[j] = d; out[j][0] = b.p[i][0]; out[j][1] = b.p[i][1]; out[j][2] = b.p[i][2];
+            }
+        }
+        return found;
+    }
+};
+
+// ---------------------------------------------------------------------------------------------------------------
+// MapFx: the exact rules the FPGA will implement (phase 1 golden model). FPGA_NN_MODE=voxfx
+//   coordinates int32 Q16.16 metres; voxel index = coord >> 15 (0.5 m = 2^15); the low 15 bits are the offset inside
+//   the voxel, so the FPGA stores a point as 3 x 16-bit offsets without losing anything.
+//   table: 2^16 groups x 8 slots (one group = 128 SDRAM words = one row segment); group = bits 8..23 of
+//   (uint32)(x + 1021*y + 262147*z) * 2654435761; a voxel lives in the first free slot of its group (tag = voxel
+//   index); if all 8 are taken by other voxels it is dropped (counted). Distances are exact int64.
+//   (first version used 2^18 slots, hash = low bits XOR, probe 2 -> 1.45 M dropped adds on eee_03)
+//   Forgetting (2026-11-10): when a new voxel finds its group full, the slot whose voxel is farthest from the new
+//   voxel (Chebyshev distance in voxels, lowest slot on ties) is reused if that distance is > keep; otherwise the
+//   add is dropped. New points lie within the LiDAR range r of the sensor, so keep >= 2 r only forgets voxels that
+//   are out of range. FPGA_NN_KEEP = keep in metres (default 200, 0 = never forget, max 2047 m);
+//   FPGA_NN_GBITS = log2 of the number of groups (default 16 = 16 MB; smaller only to test forgetting).
+//   Search order (matters for ties): dx, dy, dz = -1..1 (dz fastest), points in slot order; a later point
+//   replaces an earlier one only if strictly closer.
+// ---------------------------------------------------------------------------------------------------------------
+struct MapFx {
+    static const int NGROUP = 1 << 16, WAYS = 8, NSLOT = NGROUP * WAYS;
+    struct Slot { int n = 0; int32_t v[3]; int32_t p[CAP][3]; };
+    std::vector<Slot> t;
+    long dropped = 0, n_voxels = 0, evicted = 0;
+    uint32_t gmask = NGROUP - 1; int32_t keep = 400;          // keep radius in voxels (0.5 m)
+    MapFx() : t(NSLOT) { configure(); }
+    static int gbits_env() { const char *e = getenv("FPGA_NN_GBITS"); int b = e ? atoi(e) : 16; return b < 1 || b > 16 ? 16 : b; }
+    static int keep_env() {                                    // in voxels, 12 bits on the FPGA
+        const char *e = getenv("FPGA_NN_KEEP"); double m = e ? atof(e) : 200.0;
+        int k = (int)std::lrint(m * 2.0); return k < 0 ? 0 : k > 4095 ? 4095 : k;
+    }
+    // the CLEAR command's low 16 bits: [15:12] = gbits (0 = 16), [11:0] = keep in voxels
+    static uint32_t clear_cfg() { return ((uint32_t)(gbits_env() & 15) << 12) | (uint32_t)keep_env(); }
+    void configure() { gmask = (1u << gbits_env()) - 1; keep = keep_env(); }
+
+    static int32_t fx(float a) { return (int32_t)std::lrint((double)a * 65536.0); }
+    uint32_t group(const int32_t *v) const {
+        uint32_t s = (uint32_t)v[0] + (uint32_t)v[1] * 1021u + (uint32_t)v[2] * 262147u;
+        return ((s * 2654435761u) >> 8) & gmask;
+    }
+    static int64_t dc2(const int32_t *p, const int32_t *v) {          // squared distance to the voxel centre, Q32
+        int64_t s = 0;
+        for (int i = 0; i < 3; i++) { int64_t c = ((int64_t)v[i] << 15) + (1 << 14), d = c - p[i]; s += d * d; }
+        return s;
+    }
+    Slot *find(const int32_t *v, bool create) {
+        uint32_t g = group(v) * WAYS;
+        for (int k = 0; k < WAYS; k++) {
+            Slot &s = t[g + k];
+            if (s.n > 0 && s.v[0] == v[0] && s.v[1] == v[1] && s.v[2] == v[2]) return &s;
+        }
+        if (!create) return nullptr;
+        for (int k = 0; k < WAYS; k++) {
+            Slot &s = t[g + k];
+            if (s.n == 0) { s.v[0] = v[0]; s.v[1] = v[1]; s.v[2] = v[2]; n_voxels++; return &s; }
+        }
+        if (keep > 0) {                                        // forget the farthest voxel of the group
+            int far = 0; int32_t fd = -1;
+            for (int k = 0; k < WAYS; k++) {
+                const Slot &s = t[g + k];
+                int32_t d = std::max(std::abs(s.v[0] - v[0]), std::max(std::abs(s.v[1] - v[1]), std::abs(s.v[2] - v[2])));
+                if (d > fd) { fd = d; far = k; }
+            }
+            if (fd > keep) {
+                Slot &s = t[g + far]; s.n = 0; s.v[0] = v[0]; s.v[1] = v[1]; s.v[2] = v[2]; evicted++; return &s;
+            }
+        }
+        dropped++;
+        return nullptr;
+    }
+    void add(const float *pf, bool downsample) {
+        int32_t p[3] = {fx(pf[0]), fx(pf[1]), fx(pf[2])}, v[3] = {p[0] >> 15, p[1] >> 15, p[2] >> 15};
+        Slot *s = find(v, true);
+        if (!s) return;
+        if (s->n == 0) { std::memcpy(s->p[0], p, sizeof(p)); s->n = 1; return; }
+        if (downsample) {
+            int64_t best = dc2(p, v); const int32_t *bp = p;
+            for (int i = 0; i < s->n; i++) { int64_t d = dc2(s->p[i], v); if (d < best) { best = d; bp = s->p[i]; } }
+            int32_t keep[3] = {bp[0], bp[1], bp[2]};
+            s->n = 1; std::memcpy(s->p[0], keep, sizeof(keep));
+        } else if (s->n < CAP) {
+            std::memcpy(s->p[s->n++], p, sizeof(p));
+        } else {
+            int far = 0; int64_t fd = -1;
+            for (int i = 0; i < CAP; i++) { int64_t d = dc2(s->p[i], v); if (d > fd) { fd = d; far = i; } }
+            std::memcpy(s->p[far], p, sizeof(p));
+        }
+    }
+    int search(const float *qf, int K, float (*out)[3], float *d2f) {
+        int32_t q[3] = {fx(qf[0]), fx(qf[1]), fx(qf[2])}, v0[3] = {q[0] >> 15, q[1] >> 15, q[2] >> 15};
+        int64_t d2[8]; int32_t o[8][3]; int found = 0;
+        for (int dx = -1; dx <= 1; dx++) for (int dy = -1; dy <= 1; dy++) for (int dz = -1; dz <= 1; dz++) {
+            int32_t v[3] = {v0[0] + dx, v0[1] + dy, v0[2] + dz};
+            Slot *s = find(v, false);
+            if (!s) continue;
+            for (int i = 0; i < s->n; i++) {
+                int64_t ex = s->p[i][0] - q[0], ey = s->p[i][1] - q[1], ez = s->p[i][2] - q[2];
+                int64_t d = ex * ex + ey * ey + ez * ez;
+                int j;
+                if (found < K) j = found++;
+                else { if (d >= d2[K - 1]) continue; j = K - 1; }
+                while (j > 0 && d2[j - 1] > d) { d2[j] = d2[j - 1]; std::memcpy(o[j], o[j - 1], sizeof(o[0])); j--; }
+                d2[j] = d; o[j][0] = s->p[i][0]; o[j][1] = s->p[i][1]; o[j][2] = s->p[i][2];
+            }
+        }
+        for (int k = 0; k < found; k++) {
+            for (int i = 0; i < 3; i++) out[k][i] = (float)(o[k][i] / 65536.0);
+            d2f[k] = (float)(d2[k] / 4294967296.0);
+        }
+        return found;
+    }
+};
+
+inline int mode() {      // 0 off, 1 float voxel map, 2 fixed-point (FPGA rules)
+    static int e = -1;
+    if (e < 0) {
+        const char *m = getenv("FPGA_NN_MODE");
+        e = !m ? 0 : std::string(m) == "voxel" ? 1 : std::string(m) == "voxfx" ? 2 : std::string(m) == "fpga" ? 3 : 0;
+    }
+    return e;
+}
+inline bool enabled() { return mode() != 0; }
+inline Map &map() {
+    static Map M;
+    static bool init = false;
+    if (!init) {
+        init = true;
+        if (const char *r = getenv("FPGA_NN_R")) M.R = atoi(r);
+        fprintf(stderr, "[voxmap] %s, R=%d (%d voxels per search), CAP=%d\n", enabled() ? "ON" : "off", M.R,
+                (2 * M.R + 1) * (2 * M.R + 1) * (2 * M.R + 1), CAP);
+    }
+    return M;
+}
+
+inline MapFx &mapfx() { static MapFx M; return M; }
+
+// FPGA_NN_DUMP=file (voxfx mode): record every operation as int32 records for the FPGA exam:
+//   ADD    : 1, downsample, x, y, z                       (Q16.16)
+//   SEARCH : 2, x, y, z, found, then 5 x (x, y, z, d2_hi, d2_lo)   (d2 in Q32, unused entries 0)
+inline FILE *nn_dump() {
+    static FILE *f = nullptr; static bool init = false;
+    if (!init) { init = true; if (const char *d = getenv("FPGA_NN_DUMP")) f = fopen(d, "wb"); }
+    return f;
+}
+// ---------------------------------------------------------------------------------------------------------------
+// FPGA_NN_MODE=fpga : the map lives in the board's SDRAM (fpga_lio/fpga/nn). Same rules as MapFx, so the answers are
+// bit-identical to mode voxfx. Adds are buffered and sent once per scan (flush_adds); searches are sent in batches.
+// Packets: 0xA511|n + n ops x {flags, x, y, z} (<= 72 ops, <= 18 searches); 0xA513|cfg = clear + configure;
+// 0xA514 = statistics; reply 0xA512|n + n x 16 words (statistics: 0xA5120000, dropped, forgotten).
+// ---------------------------------------------------------------------------------------------------------------
+struct FpgaNN {
+    int sock = -1; sockaddr_in board{}; bool ok = false;
+    std::vector<std::array<int32_t, 4>> pending_adds;
+    long n_add = 0, n_search = 0, n_pkt = 0; double t_add = 0, t_search = 0;
+    static void put(std::vector<uint8_t> &b, uint32_t w) { b.push_back(w >> 24); b.push_back(w >> 16); b.push_back(w >> 8); b.push_back(w); }
+    void init() {
+        sock = socket(AF_INET, SOCK_DGRAM, 0);
+        sockaddr_in me{}; me.sin_family = AF_INET; me.sin_addr.s_addr = INADDR_ANY; bind(sock, (sockaddr *)&me, sizeof(me));
+        int buf = 4 << 20; setsockopt(sock, SOL_SOCKET, SO_RCVBUF, &buf, sizeof(buf)); setsockopt(sock, SOL_SOCKET, SO_SNDBUF, &buf, sizeof(buf));
+        timeval tv{1, 0}; setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+        const char *host = getenv("FPGA_HTH_HOST");
+        board.sin_family = AF_INET; board.sin_port = htons(1234); inet_pton(AF_INET, host ? host : "192.168.137.234", &board.sin_addr);
+        std::vector<uint8_t> c; put(c, 0xA5130000u | MapFx::clear_cfg());   // clear the map, set size + keep radius
+        sendto(sock, c.data(), c.size(), 0, (sockaddr *)&board, sizeof(board));
+        uint8_t rx[2048]; ok = recv(sock, rx, sizeof(rx), 0) >= 4;
+        fprintf(stderr, "[voxmap] FPGA map %s (window %s packets, 2^%d groups, keep %.1f m)\n", ok ? "cleared, ready" : "DID NOT ANSWER",
+                getenv("FPGA_NN_WINDOW") ? getenv("FPGA_NN_WINDOW") : "16", MapFx::gbits_env(), MapFx::keep_env() * 0.5);
+    }
+    // send packets with up to W in flight, collect replies in order; out_words gets every reply's search words
+    // W = packets in flight. The board's receive FIFO holds 2048 words: a search packet is 73 words (16 fit),
+    // an add packet 289 words (at most 7 fit).
+    void run(const std::vector<std::vector<uint8_t>> &pk, std::vector<uint32_t> &out_words, size_t W) {
+        size_t sent = 0, got = 0; uint8_t rx[2048];
+        while (got < pk.size()) {
+            while (sent < pk.size() && sent - got < W) { sendto(sock, pk[sent].data(), pk[sent].size(), 0, (sockaddr *)&board, sizeof(board)); sent++; }
+            ssize_t n = recv(sock, rx, sizeof(rx), 0);
+            if (n < 4) { fprintf(stderr, "[voxmap] FPGA reply timeout (packet %zu of %zu) - map is now out of step\n", got, pk.size()); ok = false; return; }
+            for (ssize_t i = 4; i + 4 <= n; i += 4) out_words.push_back(((uint32_t)rx[i] << 24) | ((uint32_t)rx[i+1] << 16) | ((uint32_t)rx[i+2] << 8) | rx[i+3]);
+            got++;
+        }
+        n_pkt += pk.size();
+    }
+    // the board's own counters (command 0xA514): adds dropped because the group was full, voxels forgotten
+    bool stats(uint32_t &dropped, uint32_t &forgotten) {
+        if (!ok) return false;
+        std::vector<uint8_t> c; put(c, 0xA5140000u);
+        sendto(sock, c.data(), c.size(), 0, (sockaddr *)&board, sizeof(board));
+        uint8_t rx[2048]; if (recv(sock, rx, sizeof(rx), 0) < 12) return false;
+        dropped = ((uint32_t)rx[4] << 24) | ((uint32_t)rx[5] << 16) | ((uint32_t)rx[6] << 8) | rx[7];
+        forgotten = ((uint32_t)rx[8] << 24) | ((uint32_t)rx[9] << 16) | ((uint32_t)rx[10] << 8) | rx[11];
+        return true;
+    }
+    void flush_adds() {
+        if (pending_adds.empty() || !ok) { pending_adds.clear(); return; }
+        double t0 = omp_get_wtime();
+        std::vector<std::vector<uint8_t>> pk;
+        for (size_t s = 0; s < pending_adds.size(); s += 72) {
+            size_t e = std::min(pending_adds.size(), s + 72);
+            std::vector<uint8_t> b; put(b, 0xA5110000u | (uint32_t)(e - s));
+            for (size_t k = s; k < e; k++) for (int i = 0; i < 4; i++) put(b, (uint32_t)pending_adds[k][i]);
+            pk.push_back(b);
+        }
+        std::vector<uint32_t> w; run(pk, w, 6);
+        n_add += pending_adds.size(); pending_adds.clear(); t_add += omp_get_wtime() - t0;
+    }
+    // q: n x 3 floats -> per query: found, 5 x 3 floats, 5 squared distances (same arithmetic as MapFx::search)
+    void search_batch(const std::vector<std::array<float, 3>> &q, std::vector<int> &found, std::vector<std::array<float, 15>> &pts,
+                      std::vector<std::array<float, 5>> &d2) {
+        double t0 = omp_get_wtime();
+        size_t n = q.size(); found.assign(n, 0); pts.resize(n); d2.resize(n);
+        if (!ok) return;
+        std::vector<std::vector<uint8_t>> pk; std::vector<std::array<int32_t, 3>> qi(n);
+        for (size_t s = 0; s < n; s += 18) {
+            size_t e = std::min(n, s + 18);
+            std::vector<uint8_t> b; put(b, 0xA5110000u | (uint32_t)(e - s));
+            for (size_t k = s; k < e; k++) {
+                qi[k] = {MapFx::fx(q[k][0]), MapFx::fx(q[k][1]), MapFx::fx(q[k][2])};
+                put(b, 1u); for (int i = 0; i < 3; i++) put(b, (uint32_t)qi[k][i]);
+            }
+            pk.push_back(b);
+        }
+        static const size_t WS = getenv("FPGA_NN_WINDOW") ? (size_t)atoi(getenv("FPGA_NN_WINDOW")) : 16;
+        std::vector<uint32_t> w; run(pk, w, WS);
+        if (w.size() < 16 * n) return;
+        for (size_t k = 0; k < n; k++) {
+            const uint32_t *r = &w[16 * k];
+            found[k] = (int)r[0];
+            for (int j = 0; j < found[k] && j < 5; j++) {
+                int32_t p[3] = {(int32_t)r[1 + 3 * j], (int32_t)r[2 + 3 * j], (int32_t)r[3 + 3 * j]};
+                int64_t ex = p[0] - qi[k][0], ey = p[1] - qi[k][1], ez = p[2] - qi[k][2];
+                for (int i = 0; i < 3; i++) pts[k][3 * j + i] = (float)(p[i] / 65536.0);
+                d2[k][j] = (float)((ex * ex + ey * ey + ez * ez) / 4294967296.0);
+            }
+        }
+        n_search += n; t_search += omp_get_wtime() - t0;
+    }
+};
+inline FpgaNN &fpga() { static FpgaNN F; static bool init = false; if (!init) { init = true; F.init(); } return F; }
+
+inline void add(const float *p, bool ds) {
+    if (mode() == 3) { fpga().pending_adds.push_back({ds ? 2 : 0, MapFx::fx(p[0]), MapFx::fx(p[1]), MapFx::fx(p[2])}); return; }
+    if (mode() == 2) {
+        if (FILE *f = nn_dump()) { int32_t r[5] = {1, ds ? 1 : 0, MapFx::fx(p[0]), MapFx::fx(p[1]), MapFx::fx(p[2])}; fwrite(r, 4, 5, f); }
+        mapfx().add(p, ds);
+    } else map().add(p, ds);
+}
+inline int search(const float *q, int K, float (*out)[3], float *d2) {
+    if (mode() != 2) return map().search(q, K, out, d2);
+    int n = mapfx().search(q, K, out, d2);
+    if (FILE *f = nn_dump()) {
+        int32_t r[5 + 25] = {2, MapFx::fx(q[0]), MapFx::fx(q[1]), MapFx::fx(q[2]), n};
+        for (int k = 0; k < n; k++) {
+            int64_t dd = (int64_t)std::llrint((double)d2[k] * 4294967296.0);
+            r[5 + 5 * k] = MapFx::fx(out[k][0]); r[6 + 5 * k] = MapFx::fx(out[k][1]); r[7 + 5 * k] = MapFx::fx(out[k][2]);
+            r[8 + 5 * k] = (int32_t)(dd >> 32); r[9 + 5 * k] = (int32_t)(dd & 0xFFFFFFFF);
+        }
+        #pragma omp critical(nn_dump)
+        fwrite(r, 4, 30, f);
+    }
+    return n;
+}
+
