diff --git a/include/fpga_hth.hpp b/include/fpga_hth.hpp
new file mode 100644
index 0000000..3350684
--- /dev/null
+++ b/include/fpga_hth.hpp
@@ -0,0 +1,199 @@
+// fpga_hth.hpp - hook that lets FAST-LIO get H^T H and H^T h from somewhere else than Eigen (added 2026-11-10)
+//
+// Controlled by environment variables (nothing changes when none is set):
+//   FPGA_HTH_MODE = cpu    : normal FAST-LIO (default)
+//                 = fixed  : software model of the FPGA fixed-point arithmetic (bit-identical to the board)
+//                 = fpga   : send the points to the board over UDP and use its answer
+//   FPGA_HTH_DUMP = file   : append every iteration's inputs + CPU (float64) result to a binary file
+//   FPGA_HTH_HOST = 192.168.137.234 (default), FPGA_HTH_PORT = 1234
+//   FPGA_HTH_TRAJ = file   : write the state after every scan as a TUM trajectory
+// Formats and protocol: fpga_lio/fpga/hth/SPEC.md
+#pragma once
+#include <Eigen/Core>
+#include <Eigen/Geometry>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace fpga_hth {
+
+typedef __int128 i128;
+
+struct Point { int32_t pb[3], n[3], pd2; };
+
+struct Config {
+    std::string mode = "cpu";
+    FILE *dump = nullptr;
+    FILE *traj = nullptr;
+    int sock = -1;
+    sockaddr_in board{};
+    uint16_t iter_id = 0;
+    long n_calls = 0, n_retries = 0, n_points = 0;
+    double t_total = 0.0;
+};
+
+inline Config &cfg() {
+    static Config c;
+    static bool init = false;
+    if (!init) {
+        init = true;
+        if (const char *m = getenv("FPGA_HTH_MODE")) c.mode = m;
+        if (const char *d = getenv("FPGA_HTH_DUMP")) c.dump = fopen(d, "wb");
+        if (const char *t = getenv("FPGA_HTH_TRAJ")) c.traj = fopen(t, "w");
+        if (c.mode == "fpga") {
+            const char *host = getenv("FPGA_HTH_HOST"); const char *port = getenv("FPGA_HTH_PORT");
+            c.sock = socket(AF_INET, SOCK_DGRAM, 0);
+            sockaddr_in me{}; me.sin_family = AF_INET; me.sin_addr.s_addr = INADDR_ANY; me.sin_port = 0;
+            bind(c.sock, (sockaddr *)&me, sizeof(me));
+            int buf = 4 << 20; setsockopt(c.sock, SOL_SOCKET, SO_SNDBUF, &buf, sizeof(buf));
+            timeval tv{0, 200000}; setsockopt(c.sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+            c.board.sin_family = AF_INET;
+            c.board.sin_port = htons(port ? atoi(port) : 1234);
+            inet_pton(AF_INET, host ? host : "192.168.137.234", &c.board.sin_addr);
+        }
+        fprintf(stderr, "[fpga_hth] mode=%s dump=%s traj=%s\n", c.mode.c_str(), c.dump ? "on" : "off", c.traj ? "on" : "off");
+    }
+    return c;
+}
+
+inline int32_t q(double x, int frac) {
+    double v = std::nearbyint(x * double(1LL << frac));
+    if (v > 2147483647.0 || v < -2147483648.0) { fprintf(stderr, "[fpga_hth] value %g does not fit Q%d\n", x, frac); abort(); }
+    return (int32_t)v;
+}
+
+// ---------------------------------------------------------------- golden fixed-point model (same as hth_model.py)
+inline void fixed_sums(const int32_t R[9], const int32_t RL[9], const int32_t tL[3], const std::vector<Point> &pts, i128 S[27]) {
+    for (int k = 0; k < 27; k++) S[k] = 0;
+    for (const Point &P : pts) {
+        int64_t p[3], C[3], A[3], H[6];
+        for (int i = 0; i < 3; i++)
+            p[i] = (int32_t)(int64_t)(((i128)RL[3 * i] * P.pb[0] + (i128)RL[3 * i + 1] * P.pb[1] + (i128)RL[3 * i + 2] * P.pb[2] + ((i128)tL[i] << 30)) >> 30);
+        for (int i = 0; i < 3; i++)
+            C[i] = (int32_t)(int64_t)(((i128)R[i] * P.n[0] + (i128)R[3 + i] * P.n[1] + (i128)R[6 + i] * P.n[2]) >> 30);
+        A[0] = (int64_t)(((i128)p[1] * C[2] - (i128)p[2] * C[1]) >> 30);
+        A[1] = (int64_t)(((i128)p[2] * C[0] - (i128)p[0] * C[2]) >> 30);
+        A[2] = (int64_t)(((i128)p[0] * C[1] - (i128)p[1] * C[0]) >> 30);
+        for (int i = 0; i < 3; i++) { H[i] = P.n[i]; H[3 + i] = (int32_t)A[i]; }   // board keeps 32 bits
+        int s = 0;
+        for (int i = 0; i < 6; i++) for (int j = i; j < 6; j++) S[s++] += (i128)H[i] * H[j];
+        for (int i = 0; i < 6; i++) S[21 + i] -= (i128)H[i] * P.pd2;
+    }
+}
+
+inline void sums_to_float(const i128 S[27], Eigen::Matrix<double, 12, 12> &HTH, Eigen::Matrix<double, 12, 1> &HTh) {
+    static const int sc[6] = {30, 30, 30, 16, 16, 16};
+    HTH.setZero(); HTh.setZero();
+    int s = 0;
+    for (int i = 0; i < 6; i++) for (int j = i; j < 6; j++) {
+        double v = (double)S[s++] / std::ldexp(1.0, sc[i] + sc[j]);
+        HTH(i, j) = HTH(j, i) = v;
+    }
+    for (int i = 0; i < 6; i++) HTh(i) = (double)S[21 + i] / std::ldexp(1.0, sc[i] + 24);
+}
+
+// ---------------------------------------------------------------- UDP client
+inline void put32(std::vector<uint8_t> &b, uint32_t w) { b.push_back(w >> 24); b.push_back(w >> 16); b.push_back(w >> 8); b.push_back(w); }
+
+inline bool fpga_sums(Config &c, const int32_t R[9], const int32_t RL[9], const int32_t tL[3], const std::vector<Point> &pts, i128 S[27]) {
+    for (int attempt = 0; attempt < 5; attempt++) {
+        uint16_t id = ++c.iter_id;
+        std::vector<std::vector<uint8_t>> pk;
+        pk.emplace_back(); put32(pk.back(), 0xA5000000u | (2u << 16) | 0u);           // warm-up: POINTS with 0 points (ignored)
+        pk.emplace_back(); put32(pk.back(), 0xA5000000u | (1u << 16) | id);           // BEGIN
+        for (int i = 0; i < 9; i++) put32(pk.back(), R[i]);
+        for (int i = 0; i < 9; i++) put32(pk.back(), RL[i]);
+        for (int i = 0; i < 3; i++) put32(pk.back(), tL[i]);
+        for (size_t s = 0; s < pts.size(); s += 41) {
+            size_t e = std::min(pts.size(), s + 41);
+            std::vector<uint8_t> p; put32(p, 0xA5000000u | (2u << 16) | (uint32_t)(e - s));
+            for (size_t k = s; k < e; k++) {
+                for (int i = 0; i < 3; i++) put32(p, pts[k].pb[i]);
+                for (int i = 0; i < 3; i++) put32(p, pts[k].n[i]);
+                put32(p, pts[k].pd2);
+            }
+            pk.push_back(p);
+        }
+        pk.emplace_back(); put32(pk.back(), 0xA5000000u | (3u << 16));
+        for (auto &p : pk) sendto(c.sock, p.data(), p.size(), 0, (sockaddr *)&c.board, sizeof(c.board));
+        uint8_t rx[512];
+        while (true) {
+            ssize_t n = recv(c.sock, rx, sizeof(rx), 0);
+            if (n < 0) break;                                                           // timeout -> retry
+            if (n != 340) continue;
+            auto w = [&](int i) { return ((uint32_t)rx[4 * i] << 24) | ((uint32_t)rx[4 * i + 1] << 16) | ((uint32_t)rx[4 * i + 2] << 8) | rx[4 * i + 3]; };
+            if ((w(0) & 0xFFFF) != id) continue;                                        // stale reply
+            if (w(1) != pts.size() || (w(2) >> 16) != 0 || (w(2) & 1)) break;          // lost packet -> retry
+            for (int k = 0; k < 27; k++) {
+                uint64_t hi = w(4 + 3 * k), mid = w(5 + 3 * k), lo = w(6 + 3 * k);
+                i128 v = ((i128)(int32_t)hi << 64) | ((i128)mid << 32) | lo;            // hi is sign-extended
+                S[k] = v;
+            }
+            return true;
+        }
+        c.n_retries++;
+    }
+    fprintf(stderr, "[fpga_hth] board did not answer correctly 5 times\n");
+    return false;
+}
+
+// ---------------------------------------------------------------- entry point used by h_share_model
+// R = s.rot, RL/tL = extrinsic, pts in float. h_x (n x 12) and h are already filled by FAST-LIO (used for dump only).
+template <class M3, class V3, class PCL, class HX, class HV>
+inline bool compute(const M3 &Rf, const M3 &RLf, const V3 &tLf, const PCL &laser, const PCL &norm, int npts,
+                    const HX &h_x, const HV &h, Eigen::Matrix<double, 12, 12> &HTH, Eigen::Matrix<double, 12, 1> &HTh) {
+    Config &c = cfg();
+    if (c.dump) {   // record: npts, R, RL, tL (double), then per point pb(3) n(3) pd2 (float), then CPU HTH 6x6 + HTh 6 (double)
+        int32_t n32 = npts; fwrite(&n32, 4, 1, c.dump);
+        double m[21];
+        for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) { m[3 * i + j] = Rf(i, j); m[9 + 3 * i + j] = RLf(i, j); }
+        for (int i = 0; i < 3; i++) m[18 + i] = tLf(i);
+        fwrite(m, 8, 21, c.dump);
+        for (int k = 0; k < npts; k++) {
+            float f[7] = {laser->points[k].x, laser->points[k].y, laser->points[k].z, norm->points[k].x, norm->points[k].y, norm->points[k].z, norm->points[k].intensity};
+            fwrite(f, 4, 7, c.dump);
+        }
+        Eigen::Matrix<double, 6, 6> A = h_x.leftCols(6).transpose() * h_x.leftCols(6);
+        Eigen::Matrix<double, 6, 1> b = h_x.leftCols(6).transpose() * h;
+        fwrite(A.data(), 8, 36, c.dump); fwrite(b.data(), 8, 6, c.dump);
+    }
+    if (c.mode == "cpu") return false;
+    struct timeval t0, t1; gettimeofday(&t0, nullptr);
+    int32_t R[9], RL[9], tL[3];
+    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) { R[3 * i + j] = q(Rf(i, j), 30); RL[3 * i + j] = q(RLf(i, j), 30); }
+    for (int i = 0; i < 3; i++) tL[i] = q(tLf(i), 16);
+    std::vector<Point> pts(npts);
+    for (int k = 0; k < npts; k++) {
+        pts[k].pb[0] = q(laser->points[k].x, 16); pts[k].pb[1] = q(laser->points[k].y, 16); pts[k].pb[2] = q(laser->points[k].z, 16);
+        pts[k].n[0] = q(norm->points[k].x, 30); pts[k].n[1] = q(norm->points[k].y, 30); pts[k].n[2] = q(norm->points[k].z, 30);
+        pts[k].pd2 = q(norm->points[k].intensity, 24);
+    }
+    i128 S[27];
+    if (c.mode == "fpga") { if (!fpga_sums(c, R, RL, tL, pts, S)) return false; }
+    else fixed_sums(R, RL, tL, pts, S);
+    sums_to_float(S, HTH, HTh);
+    gettimeofday(&t1, nullptr);
+    c.n_calls++; c.n_points += npts; c.t_total += (t1.tv_sec - t0.tv_sec) + 1e-6 * (t1.tv_usec - t0.tv_usec);
+    if (c.n_calls % 2000 == 0)
+        fprintf(stderr, "[fpga_hth] %ld iterations, %ld points, %.3f ms/iteration, %ld retries\n",
+                c.n_calls, c.n_points, 1e3 * c.t_total / c.n_calls, c.n_retries);
+    return true;
+}
+
+inline void write_traj(double t, const Eigen::Vector3d &p, const Eigen::Quaterniond &qt) {
+    Config &c = cfg();
+    if (!c.traj) return;
+    fprintf(c.traj, "%.9f %.6f %.6f %.6f %.9f %.9f %.9f %.9f\n", t, p.x(), p.y(), p.z(), qt.x(), qt.y(), qt.z(), qt.w());
+    fflush(c.traj);
+}
+
