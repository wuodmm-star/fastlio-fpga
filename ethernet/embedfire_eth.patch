+reg     [7:0]   ip_flags_hi     ;   //IP首部第6字节: 标志位(含MF) + 片偏移高5位   (added 2026-11-09)
+reg     [7:0]   ip_flags_lo     ;   //IP首部第7字节: 片偏移低8位
+reg     [7:0]   ip_proto        ;   //IP首部第9字节: 协议号, UDP = 17
+wire            ip_hdr_ok       ;   //是UDP且不是分片
 
 //********************************************************************//
 //***************************** Main Code ****************************//
@@ -116,6 +125,11 @@
 always@(posedge sys_clk or negedge sys_rst_n)
     if(sys_rst_n == 1'b0)
         state   <=  IDLE;
+    // 2026-11-10: between frames always restart from IDLE. The original state machine kept its state across frames,
+    // so a foreign frame (e.g. a Windows broadcast) that ended half-way through a header left it mid-count and the
+    // next frame's preamble was mis-counted and dropped (seen as lost first packets after idle).
+    else    if(eth_rxdv_reg == 1'b0)
+        state   <=  IDLE;
     else    case(state)
         IDLE:
             if(sw_en == 1'b1)
@@ -175,7 +189,8 @@
         sw_en   <=  1'b1;
     else    if((state == IP_HEAD) && (data_en == 1'b1)
         && (cnt_byte == ip_len - 1'b1)
-        && (des_ip[23:0] == BOARD_IP[31:8]) && (data == BOARD_IP[7:0]))
+        && (des_ip[23:0] == BOARD_IP[31:8]) && (data == BOARD_IP[7:0])
+        && (ip_hdr_ok == 1'b1))
         sw_en   <=  1'b1;
     else    if((state == UDP_HEAD) && (data_en == 1'b1)
         && (cnt_byte == 8'd7))
@@ -212,6 +227,8 @@
 always @(posedge sys_clk or negedge sys_rst_n)
     if(sys_rst_n == 1'b0)
         cnt_byte    <=  5'd0;
+    else    if(eth_rxdv_reg == 1'b0)                   // 2026-11-10: restart between frames
+        cnt_byte    <=  5'd0;
     else    if((state == PACKET_HEAD) && (data_en == 1'b1))
         if(cnt_byte == 5'd6)
             cnt_byte <= 5'd0;
@@ -265,8 +282,29 @@
         des_ip  <=  {des_ip[23:0],data};
 
 //ip_flag:IP地址正确标志
+// 2026-11-09: also require "UDP, not a fragment" (ip_hdr_ok). A fragmented datagram used to be
+// glued together with the next frame's header bytes and echoed back as garbage.
 assign  ip_flag = ((des_ip[23:0] == BOARD_IP[31:8])
-            && (data == BOARD_IP[7:0])) ? 1'b1 : 1'b0;
+            && (data == BOARD_IP[7:0]) && (ip_hdr_ok == 1'b1)) ? 1'b1 : 1'b0;
+//ip_flags_hi / ip_flags_lo / ip_proto: captured from the IP header (added 2026-11-09)
+always@(posedge sys_clk or negedge sys_rst_n)
+    if(sys_rst_n == 1'b0)
+        begin
+            ip_flags_hi <=  8'd0;
+            ip_flags_lo <=  8'd0;
+            ip_proto    <=  8'd0;
+        end
+    else    if((state == IP_HEAD) && (data_en == 1'b1))
+        begin
+            if(cnt_byte == 5'd6)    ip_flags_hi <=  data;
+            if(cnt_byte == 5'd7)    ip_flags_lo <=  data;
+            if(cnt_byte == 5'd9)    ip_proto    <=  data;
+        end
+
+//ip_hdr_ok: UDP (17), MF flag clear, fragment offset zero
+assign  ip_hdr_ok = (ip_proto == 8'd17) && (ip_flags_hi[5] == 1'b0)
+                    && ({ip_flags_hi[4:0],ip_flags_lo} == 13'd0);
+
 //ip_len:IP首部字节长度
 always@(posedge sys_clk or negedge sys_rst_n)
     if(sys_rst_n == 1'b0)
@@ -290,6 +328,8 @@
 always@(posedge sys_clk or negedge sys_rst_n)
     if(sys_rst_n == 1'b0)
         cnt_data    <=  16'd0;
+    else    if(eth_rxdv_reg == 1'b0)                   // 2026-11-10: restart between frames
+        cnt_data    <=  16'd0;
     else    if((state == REC_DATA) && (data_en == 1'b1))
         if(cnt_data == (data_len - 1'b1))
             cnt_data    <=  16'd0;
@@ -336,6 +376,8 @@
 always@(posedge sys_clk or negedge sys_rst_n)
     if(sys_rst_n == 1'b0)
         cnt_rec_data    <=  2'd0;
+    else    if(eth_rxdv_reg == 1'b0)                   // 2026-11-10: restart between frames
+        cnt_rec_data    <=  2'd0;
     else    if((state == REC_DATA) && (data_en == 1'b1))
         if(cnt_data == (data_len - 1'b1))
             cnt_rec_data    <=  2'd0;
@@ -352,4 +394,54 @@
     else
         rec_end     <=  1'b0;
 
+//********************************************************************//
+//**** added 2026-11-09: remember the sender (reply-to-sender) *******//
+//********************************************************************//
+// While a packet arrives we copy the sender's MAC (Ethernet bytes 6..11),
+// IP (IP header bytes 12..15) and UDP port (UDP header bytes 0..1) into
+// shadow registers. They are copied to the outputs only after the MAC and IP
+// filters have passed (end of UDP header), so a packet meant for somebody
+// else can never change the reply address.
+reg     [47:0]  cap_mac ;
+reg     [31:0]  cap_ip  ;
+reg     [15:0]  cap_port;
+
+always@(posedge sys_clk or negedge sys_rst_n)
+    if(sys_rst_n == 1'b0)
+        cap_mac <=  48'h0;
+    else    if((state == ETH_HEAD) && (data_en == 1'b1)
+            && (cnt_byte >= 5'd6) && (cnt_byte <= 5'd11))
+        cap_mac <=  {cap_mac[39:0],data};
+
+always@(posedge sys_clk or negedge sys_rst_n)
+    if(sys_rst_n == 1'b0)
+        cap_ip  <=  32'h0;
+    else    if((state == IP_HEAD) && (data_en == 1'b1)
+            && (cnt_byte >= 5'd12) && (cnt_byte <= 5'd15))
+        cap_ip  <=  {cap_ip[23:0],data};
+
+always@(posedge sys_clk or negedge sys_rst_n)
+    if(sys_rst_n == 1'b0)
+        cap_port    <=  16'h0;
+    else    if((state == UDP_HEAD) && (data_en == 1'b1)
+            && (cnt_byte <= 5'd1))
+        cap_port    <=  {cap_port[7:0],data};
+
+assign  sfd_ok = (state == PACKET_HEAD) && (sw_en == 1'b1);
+
+//commit when the UDP header is complete (MAC and IP checks already passed)
+always@(posedge sys_clk or negedge sys_rst_n)
+    if(sys_rst_n == 1'b0)
+        begin
+            src_mac     <=  48'h0;
+            src_ip      <=  32'h0;
+            src_port    <=  16'h0;
+        end
+    else    if((state == UDP_HEAD) && (sw_en == 1'b1))
+        begin
+            src_mac     <=  cap_mac ;
+            src_ip      <=  cap_ip  ;
+            src_port    <=  cap_port;
+        end
+
 endmodule
